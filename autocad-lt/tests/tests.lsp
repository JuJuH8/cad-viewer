(tt:test "aplatir"
  '(lambda (/ l c p t1 i)
     (setq l (tt:line '(0.0 0.0 5.0) '(10.0 0.0 -3.0) '((39 . 2.0))))
     (entmake '((0 . "CIRCLE") (8 . "0") (10 1.0 2.0 7.0) (40 . 1.0)))
     (setq c (entlast))
     (setq p (tt:lwpoly '((0.0 0.0) (10.0 0.0)) nil '((38 . 4.0))))
     (setq t1 (tt:text "Z" '(0.0 0.0 9.0) nil))
     (tt:block "B3D" (list '((0 . "LINE") (8 . "0") (10 0.0 0.0 3.0) (11 1.0 0.0 3.0))))
     (setq i (tt:insert "B3D" '(5.0 5.0 12.0) nil))
     (tt:run '("APLATIR") nil)
     (tt:check "ligne aplatie" (and (= 0.0 (cadddr (assoc 10 (entget l)))) (= 0.0 (cadddr (assoc 11 (entget l))))))
     (tt:check "épaisseur 0" (member (tp:dxf 39 (entget l)) '(nil 0.0)))
     (tt:check "cercle aplati" (= 0.0 (cadddr (assoc 10 (entget c)))))
     (tt:check "élévation de polyligne 0" (member (tp:dxf 38 (entget p)) '(nil 0.0)))
     (tt:check "texte aplati" (= 0.0 (cadddr (assoc 10 (entget t1)))))
     (tt:check "insertion aplatie" (= 0.0 (cadddr (assoc 10 (entget i)))))
     (tt:check "contenu de bloc aplati" (= 0.0 (cadddr (assoc 10 (car (tt:block-lists "B3D"))))))))

