;; En dernier : le traitement par lot enregistre le dessin sous un autre nom.
(tt:test "traitement par lot"
  '(lambda (/ out log f lines)
     (setq out (strcat (getenv "TEMP") "\\tp_lot_sortie") log (strcat out "\\rapport.txt"))
     (vl-mkdir out)
     (foreach x (vl-directory-files out "*.*" 1) (vl-file-delete (strcat out "\\" x)))
     (tp:profile-write "Lot" (tt:cfg '("PETITS") nil))
     (tt:line '(1.0 1.0 0.0) '(1.0 1.0 0.0) nil)
     (tt:line '(0.0 0.0 0.0) '(5.0 0.0 0.0) nil)
     (setq name (getvar "DWGNAME"))
     (tp:batch-one "Lot" out log)
     (tt:check "dessin traité enregistré dans le dossier de sortie" (findfile (strcat out "\\" name)))
     (tt:check "objet nul supprimé avant enregistrement" (= 1 (tt:count "LINE")))
     (setq lines (tp:read-lines log "utf8"))
     (tt:check "rapport du lot écrit" (and lines (wcmatch (car lines) "== *")))))

