;;; Tests de « Traitement de plans » : à charger après TraitementPlans.lsp sur un dessin vide
;;; (voir run_tests.py). Chaque vérification affiche « CV-RES=OK nom » ou « CV-RES=ECHEC nom ».

(setq tt:*ok* 0 tt:*ko* 0)

;; Profils des tests dans un dossier temporaire (le dossier réel de l'utilisateur n'est pas touché).
(setq tt:*dir* (strcat (getenv "TEMP") "\\tp_tests_profils"))
(vl-mkdir tt:*dir*)
(foreach f (vl-directory-files tt:*dir* "*.tpp" 1) (vl-file-delete (strcat tt:*dir* "\\" f)))
(defun tp:dir () tt:*dir*)

(defun tt:check (name c)
  (if c
    (progn (setq tt:*ok* (1+ tt:*ok*)) (princ (strcat "\nCV-RES=OK " name)))
    (progn (setq tt:*ko* (1+ tt:*ko*)) (princ (strcat "\nCV-RES=ECHEC " name)))))

(defun tt:test (name fn / r)
  (tt:reset)
  (setq r (vl-catch-all-apply fn))
  (if (vl-catch-all-error-p r)
    (progn (setq tt:*ko* (1+ tt:*ko*))
           (princ (strcat "\nCV-RES=ECHEC " name " : erreur " (vl-catch-all-error-message r))))))

;; Réglages : toutes les opérations désactivées sauf keys, puis paramètres extra.
(defun tt:cfg (keys extra / cfg)
  (setq cfg (tp:defaults))
  (foreach k tp:*ops* (setq cfg (tp:cfg-set cfg k (if (member k keys) T nil))))
  (foreach p extra (setq cfg (tp:cfg-set cfg (car p) (cdr p))))
  cfg)

(defun tt:run (keys extra) (setq tt:*report* (tp:run (tt:cfg keys extra))))

(defun tt:reset (/ ss)
  (tp:layers-free)
  (setvar "TILEMODE" 1)
  (if (setq ss (ssget "_X")) (command "_.ERASE" ss ""))
  (repeat 3 (command "_.-PURGE" "_A" "*" "_N") (tp:end-cmd))
  (setvar "INSUNITS" 4))

(defun tt:layer (name color flags lt)
  (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
                 (cons 2 name) (cons 70 flags) (cons 62 color) (cons 6 (if lt lt "Continuous")))))

(defun tt:line (p1 p2 extra) (entmake (append (list '(0 . "LINE") '(8 . "0") (cons 10 p1) (cons 11 p2)) extra)) (entlast))
(defun tt:text (s p extra) (entmake (append (list '(0 . "TEXT") '(8 . "0") (cons 10 p) '(40 . 2.5) (cons 1 s)) extra)) (entlast))
(defun tt:mtext (s p extra)
  (entmake (append (list '(0 . "MTEXT") '(100 . "AcDbEntity") '(8 . "0") '(100 . "AcDbMText") (cons 10 p) '(40 . 2.5) (cons 1 s)) extra))
  (entlast))
(defun tt:lwpoly (pts closed extra)
  (entmake (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "0") '(100 . "AcDbPolyline")
                         (cons 90 (length pts)) (cons 70 (if closed 1 0)))
                   (mapcar '(lambda (p) (cons 10 p)) pts) extra))
  (entlast))

(defun tt:all (/ ss i r)
  (if (setq ss (ssget "_X"))
    (progn (setq i 0) (repeat (sslength ss) (setq r (cons (entget (ssname ss i) '("*")) r) i (1+ i)))))
  (reverse r))
(defun tt:of-type (typ) (vl-remove-if-not '(lambda (d) (= typ (tp:dxf 0 d))) (tt:all)))
(defun tt:count (typ) (length (tt:of-type typ)))
(defun tt:block-lists (name / e r)
  (setq e (entnext (tblobjname "BLOCK" name)))
  (while e (setq r (cons (entget e '("*")) r) e (entnext e)))
  (reverse r))
(defun tt:block-types (name) (mapcar '(lambda (d) (tp:dxf 0 d)) (tt:block-lists name)))
(defun tt:layer-flags (name) (tp:dxf 70 (tblsearch "LAYER" name)))
(defun tt:layer-color (name) (tp:dxf 62 (tblsearch "LAYER" name)))
(defun tt:near (a b) (equal a b 1e-6))

(defun tt:block (name ents / ok)
  (entmake (list '(0 . "BLOCK") (cons 2 name) '(70 . 0) '(10 0.0 0.0 0.0)))
  (foreach d ents (entmake d))
  (entmake '((0 . "ENDBLK"))))

(defun tt:insert (name p extra) (entmake (append (list '(0 . "INSERT") (cons 2 name) '(8 . "0") (cons 10 p)) extra)) (entlast))

