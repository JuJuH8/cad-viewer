(tt:test "masques et hachures pleines"
  '(lambda (/ pl w)
     (command "_.WIPEOUT" "0,0" "5,0" "5,5" "")
     (setq w (entlast))
     (setq pl (tt:lwpoly '((10.0 0.0) (20.0 0.0) (20.0 10.0) (10.0 10.0)) T nil))
     (command "_.-HATCH" "_P" "SOLID" "_S" pl "" "") (tp:end-cmd)
     (tt:check "hachure créée" (= 1 (tt:count "HATCH")))
     ;; bloc contenant un masque et une ligne
     (command "_.WIPEOUT" "30,0" "35,0" "35,5" "")
     (tt:line '(30.0 0.0 0.0) '(35.0 5.0 0.0) nil)
     (command "_.-BLOCK" "BMASQUE" "30,0" (entlast) (entnext (entnext pl)) "") (tp:end-cmd)
     (tt:insert "BMASQUE" '(30.0 0.0 0.0) nil)
     (tt:check "bloc avec masque" (member "WIPEOUT" (tt:block-types "BMASQUE")))
     (tt:run '("MASQUES" "HACH_SOLIDES") nil)
     (tt:check "masque supprimé" (null (entget w)))
     (tt:check "hachure pleine supprimée" (= 0 (tt:count "HATCH")))
     (tt:check "masque supprimé du bloc" (equal (tt:block-types "BMASQUE") '("LINE")))
     (tt:check "polyligne gardée" (entget pl))))

