;;; ---------------------------------------------------------------- blocs imbriqués

(tt:test "blocs imbriques"
  '(lambda (/ lists types circ txt el)
     (tt:layer "X" 7 0 nil)
     (tt:block "ENFANT" (list '((0 . "CIRCLE") (8 . "0") (62 . 0) (10 0.0 0.0 0.0) (40 . 1.0))
                              '((0 . "ARC") (8 . "0") (10 0.0 0.0 0.0) (40 . 2.0) (50 . 0.0) (51 . 1.0))
                              '((0 . "ATTDEF") (8 . "0") (10 0.0 0.0 0.0) (40 . 1.0) (1 . "D") (3 . "Num") (2 . "NUM") (70 . 0))))
     (tt:block "PARENT" (list '((0 . "LINE") (8 . "0") (10 0.0 0.0 0.0) (11 10.0 0.0 0.0))
                              '((0 . "INSERT") (2 . "ENFANT") (8 . "X") (62 . 5) (66 . 1) (10 5.0 5.0 0.0) (41 . 2.0) (42 . 1.0) (43 . 1.0))
                              '((0 . "ATTRIB") (8 . "0") (10 5.0 6.0 0.0) (40 . 1.0) (1 . "B12") (2 . "NUM") (70 . 0))
                              '((0 . "SEQEND") (8 . "0"))))
     (tt:insert "PARENT" '(0.0 0.0 0.0) nil)
     (tt:run '("NEXPL") nil)
     (setq lists (tt:block-lists "PARENT") types (mapcar '(lambda (d) (tp:dxf 0 d)) lists))
     (tt:check "plus de référence imbriquée" (not (member "INSERT" types)))
     (setq circ (vl-some '(lambda (d) (if (member (tp:dxf 0 d) '("CIRCLE" "ELLIPSE")) d)) lists))
     (tt:check "cercle décomposé (échelle 2 x 1 : ellipse)" (= "ELLIPSE" (tp:dxf 0 circ)))
     (tt:check "calque 0 -> calque de la référence" (= "X" (tp:dxf 8 circ)))
     (tt:check "DuBloc -> couleur de la référence" (= 5 (tp:dxf 62 circ)))
     (setq txt (vl-some '(lambda (d) (if (= "TEXT" (tp:dxf 0 d)) d)) lists))
     (tt:check "attribut -> texte avec sa valeur" (and txt (= "B12" (tp:dxf 1 txt))))
     (tt:check "pas de définition d'attribut ajoutée" (not (member "ATTDEF" types)))
     (tt:check "ligne du parent gardée" (member "LINE" types))
     (tt:check "aucun reste dans l'espace objet" (= 1 (length (tt:all))))))

