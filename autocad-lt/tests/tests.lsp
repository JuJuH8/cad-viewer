     (tt:check "composant de bloc DuBloc" (= 0 (tp:dxf 62 (car (tt:block-lists "BCOUL")))))
     ;; table de conversion
     (setq c (tt:line '(0.0 2.0 0.0) '(1.0 2.0 0.0) '((62 . 1))))
