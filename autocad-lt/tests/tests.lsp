(tt:test "conversion de calques"
  '(lambda (/ f path e1 e2 e3)
     (setq path (strcat (getenv "TEMP") "\\tp_conv_test.csv"))
     (setq f (open path "w" "utf8"))
     (write-char 65279 f)
     (write-line "Calque source;Calque cible;Couleur;Type de ligne;Epaisseur" f)
     (write-line "MUR*;A-Murs porteurs;1;;0,5" f)
     (write-line "MOB;SUPPRIMER;;;" f)
     (write-line "Été;Hiver;;ACAD_ISO02W100;" f)
     (close f)
     (tt:layer "MUR_EXT" 7 0 nil) (tt:layer "MOB" 7 0 nil) (tt:layer "Été" 7 0 nil)
     (setq e1 (tt:line '(0.0 0.0 0.0) '(10.0 0.0 0.0) '((8 . "MUR_EXT"))))
     (setq e2 (tt:line '(0.0 0.0 0.0) '(10.0 10.0 0.0) '((8 . "MOB"))))
     (setq e3 (tt:line '(0.0 0.0 0.0) '(0.0 10.0 0.0) '((8 . "Été"))))
     (tt:run '("CONV_CALQUES" "PURGE") (list (cons "TABLE_CALQUES" path)))
     (tt:check "objet déplacé sur le calque cible" (= "A-Murs porteurs" (tp:dxf 8 (entget e1))))
     (tt:check "calque cible : couleur et épaisseur" (and (= 1 (tt:layer-color "A-Murs porteurs"))
                                                          (= 50 (tp:dxf 370 (entget (tblobjname "LAYER" "A-Murs porteurs"))))))
     (tt:check "objet du calque SUPPRIMER supprimé" (null (entget e2)))
     (tt:check "accents (CSV UTF-8)" (= "Hiver" (tp:dxf 8 (entget e3))))
     (tt:check "type de ligne chargé pour le calque" (= "ACAD_ISO02W100" (strcase (tp:dxf 6 (tblsearch "LAYER" "Hiver")))))
     (tt:check "calques sources purgés" (and (null (tblsearch "LAYER" "MUR_EXT")) (null (tblsearch "LAYER" "MOB"))))
     ;; table ANSI (Excel « CSV séparateur point-virgule »)
     (setq f (open path "w"))
     (write-line "Été;Automne" f)
     (close f)
     (tt:check "CSV ANSI relu" (equal (car (tp:conv-table path)) '("Été" "Automne" nil nil nil)))
     ;; export
     (tt:check "export de la table" (tp:export-layers path))
     (tt:check "export relu" (vl-some '(lambda (r) (= "A-Murs porteurs" (car r))) (tp:csv-read path)))
     (vl-file-delete path)))

