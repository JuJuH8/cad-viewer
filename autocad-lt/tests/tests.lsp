(defun tt:rep (s n / r) (setq r "") (repeat n (setq r (strcat r s))) r)

(tt:test "unformat"
  '(lambda ()
     (tt:check "mtext : formatage retiré"
               (= (tp:mt-unformat "{\\C1;\\fArial|b1;Bonjour} \\Pmonde \\S1^2;" tp:*fmt-all* T) "Bonjour \\Pmonde 1/2"))
     (tt:check "mtext : couleurs seules retirées"
               (= (tp:mt-unformat "{\\C1;\\fArial;A}\\c255;B" '(67 99) nil) "{\\fArial;A}B"))
     (tt:check "mtext : échappements conservés" (= (tp:mt-unformat "a\\\\b\\{c\\}" tp:*fmt-all* T) "a\\\\b\\{c\\}"))
     (tt:check "mtext : rognage" (= (tp:mt-trim " \\P\\Pabc def\\P ") "abc def"))
     (tt:check "mtext : vide" (= "" (tp:trim (tp:mt-plain "{\\fArial;  }\\P"))))
     (tt:check "mt-set : découpage 250" (= 600 (strlen (tp:mt-get (tp:mt-set '((0 . "MTEXT") (1 . "x")) (tt:rep "a" 600))))))
     (tt:check "csv : découpage" (equal (tp:csv-split "a;\"b;c\";\"d\"\"e\"" ";") '("a" "b;c" "d\"e")))
     (tt:check "wc : échappement" (wcmatch "A-MUR#1" (tp:wc-escape "A-MUR#1")))
     (tt:check "source avec *" (and (tp:src-match "A-MUR.Porteur" "a-mur*") (not (tp:src-match "B-MUR" "A-MUR*"))))
     (tt:check "source exacte" (and (tp:src-match "Mur #1" "MUR #1") (not (tp:src-match "Mur #12" "Mur #1"))))
     (tt:check "longueur arc de polyligne" (tt:near (tp:seg-len '(0.0 0.0) '(2.0 0.0) 1.0) pi))))


